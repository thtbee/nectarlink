<resources>
    <!-- Dark mode: the window behind Compose is dark too, so launching
         doesn't flash a light screen. -->
    <style name="Theme.Nectarlink" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/surface</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>
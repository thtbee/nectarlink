<!-- Glance: the PC, whether it's connected, and Ring and Lock (or Wake). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bloom_bg"
    android:orientation="vertical"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/widget_pc_icon"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/widget_bloom_pill"
            android:importantForAccessibility="no"
            android:padding="8dp"
            android:src="@drawable/ic_widget_pc"
            android:tint="@color/widget_on_primary_container" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="end"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/widget_pc_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/widget_bloom_pill"
                android:paddingStart="10dp"
                android:paddingTop="4dp"
                android:paddingEnd="10dp"
                android:paddingBottom="4dp"
                android:singleLine="true"
                android:text="@string/widget_pc_connected"
                android:textColor="@color/widget_on_primary_container"
                android:textSize="12sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <TextView
                android:id="@+id/widget_pc_status_off"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/widget_bloom_pill_quiet"
                android:paddingStart="10dp"
                android:paddingTop="4dp"
                android:paddingEnd="10dp"
                android:paddingBottom="4dp"
                android:singleLine="true"
                android:text="@string/widget_pc_offline"
                android:textColor="@color/widget_on_surface_variant"
                android:textSize="12sp"
                android:textStyle="bold"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="bottom"
        android:minHeight="6dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/widget_pc_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:drawablePadding="2dp"
            android:drawableTint="@color/widget_on_surface_variant"
            android:ellipsize="end"
            android:singleLine="true"
            android:text="@string/widget_pc_no_pc"
            android:textColor="@color/widget_on_surface"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_pc_subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:singleLine="true"
            android:text="@string/widget_pc_tap_to_pair"
            android:textColor="@color/widget_on_surface_variant"
            android:textSize="13sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/widget_actions_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal"
        android:visibility="gone">

        <ImageView
            android:id="@+id/widget_btn_ring"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:background="@drawable/widget_bloom_btn_tonal"
            android:contentDescription="@string/widget_pc_ring"
            android:padding="10dp"
            android:src="@drawable/ic_widget_bell"
            android:tint="@color/widget_on_surface" />

        <ImageView
            android:id="@+id/widget_btn_power"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:background="@drawable/widget_bloom_btn_tonal"
            android:contentDescription="@string/widget_power"
            android:padding="10dp"
            android:src="@drawable/ic_widget_power"
            android:tint="@color/widget_on_surface" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/widget_btn_wake"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginTop="10dp"
        android:background="@drawable/widget_bloom_btn_primary"
        android:gravity="center"
        android:orientation="horizontal"
        android:visibility="gone">

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_widget_power"
            android:tint="@color/widget_on_primary" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:singleLine="true"
            android:text="@string/widget_pc_wake"
            android:textColor="@color/widget_on_primary"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>

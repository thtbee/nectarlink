    <string name="sms_on">On. Conversations appear on your PC, where you can read and send texts.</string>
    <string name="sms_off">Read your conversations and send texts from your PC. Nectarlink needs access to your messages and contacts for that.</string>
    <string name="calls_title">Calls on your PC</string>
    <string name="calls_on">On. Recent calls and incoming calls appear on your PC, and you can start or answer calls from there.</string>
    <string name="calls_off">See who’s calling, browse recent calls, and start or answer calls from your PC. The call itself stays on your phone. Nectarlink needs access to calls, call history, and contacts for that.</string>

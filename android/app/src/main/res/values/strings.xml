    <string name="input_service_label">Nectarlink: control from your PC</string>
    <string name="input_service_description">Lets you use your PC\'s mouse and keyboard on this phone while its screen is shown on the PC: clicks become taps, drags swipes, and typing goes into the text field you\'re in. Nectarlink uses it only while you share your screen with a paired PC, and reads nothing else.</string>
    <string name="settings_control">Control from your PC</string>
    <string name="control_title">Use your PC\'s mouse and keyboard</string>
    <string name="control_on">On: while your screen is shown on your PC, you can tap, swipe and type from there.</string>
    <string name="control_off">While your screen is shown on your PC, tap, swipe and type from there. Turn on Nectarlink in Accessibility.</string>
    <string name="local_network_title">Reach your PC on this network</string>
    <string name="local_network_text">Android asks before an app talks to devices on your network. Nectarlink needs it to reach your PC.</string>
    <string name="channel_elevated">Wireless debugging setup</string>
    <string name="elevated_title">Real touch and keys (Wireless debugging)</string>
    <string name="elevated_not_set_up">Drag in real time, use every key, and mute, hold or use the keypad on calls from a PC. Uses the phone\'s own Wireless debugging; nothing else to install.</string>
    <string name="elevated_waiting">Set up. Waiting for Wireless debugging: turn it on in Developer options (Nectarlink turns it on by itself after the first time).</string>
    <string name="elevated_starting">Starting…</string>
    <string name="elevated_running">On: your PC\'s mouse and keyboard work like a real touchscreen and keyboard.</string>
    <string name="elevated_failed">Couldn\'t start it. Check that Wireless debugging is on, then try again.</string>
    <string name="elevated_not_paired">The phone forgot Nectarlink\'s pairing. Set it up again.</string>
    <string name="elevated_set_up">Set up</string>
    <string name="elevated_turn_off">Turn off</string>
    <string name="elevated_try_again">Try again</string>
    <string name="elevated_steps_title">Set up Wireless debugging</string>
    <string name="elevated_steps">1. Turn on Developer options: in Settings › About phone, tap Build number 7 times.\n2. In Developer options, turn on Wireless debugging (on Wi-Fi), open it and tap Pair device with pairing code.\n3. Type the 6-digit code into Nectarlink\'s notification, without closing the code.</string>
    <string name="elevated_open_developer">Open Developer options</string>
    <string name="elevated_pair_title">Pair Nectarlink with Wireless debugging</string>
    <string name="elevated_pair_text">In Wireless debugging, tap Pair device with pairing code, then type the code here.</string>
    <string name="elevated_pair_action">Enter code</string>
    <string name="elevated_pair_hint">6-digit pairing code</string>
    <string name="elevated_pairing">Pairing…</string>
    <string name="elevated_no_dialog">The pairing code isn\'t showing. In Wireless debugging, tap Pair device with pairing code, then type it here.</string>
    <string name="elevated_wrong_code">That code didn\'t work. Check it and type it again.</string>

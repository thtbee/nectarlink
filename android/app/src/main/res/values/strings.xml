    <string name="settings_calls_and_contacts">Calls, contacts and messages</string>
    <string name="sms_title">Text from your PC</string>
    <string name="sms_on">On. Conversations appear on your PC, where you can read and send texts.</string>
    <string name="sms_off">Read your conversations and send texts from your PC. Nectarlink needs access to your messages and contacts for that.</string>
    <string name="calls_title">Calls on your PC</string>
    <string name="calls_on">On. Recent calls and incoming calls appear on your PC, and you can start or answer calls from there.</string>
    <string name="calls_off">See who’s calling, browse recent calls, and start or answer calls from your PC. The call itself stays on your phone. Nectarlink needs access to calls, call history, and contacts for that.</string>
    <string name="contacts_title">Contacts on your PC</string>
    <string name="contacts_on">On. Your contacts are available in Calls and Messages on your PC.</string>
    <string name="contacts_off">Search your contacts and start a call or text from your PC. Nectarlink needs access to your contacts for that.</string>
    <string name="settings_photos">Photos and videos</string>
    <string name="photos_title">Photos and videos on your PC</string>
    <string name="photos_on">On. Your photos, screenshots and videos are available on your PC.</string>
    <string name="photos_partial">Some of your photos and videos aren\'t available on your PC. Allow all of them to browse your whole gallery there.</string>
    <string name="photos_off">Browse your photos, screenshots and videos on your PC, and get new screenshots right away. Nectarlink needs access to your photos and videos for that.</string>

      "status": {
        "$note": "No green. Success / done / connected states use the theme's own color roles: primary (dot, 'On' chips) and primaryContainer/onPrimaryContainer (completed checks). Only warning and error have dedicated colors.",
        "light": {
          "success": "{primary}",
          "warning": "#9A6700",
          "error": "#BA1A1A",
          "onError": "#FFFFFF"
        },
        "dark": {
          "success": "{primary}",
          "warning": "#F2C14E",
          "error": "#FFB4AB",
          "onError": "#690005"
        }
      },

  "typography": {
    "displayLarge": {
      "size": 44,
      "lineHeight": 1.05,
      "weight": 650,
      "tracking": -0.025
    },
    "displaySmall": {
      "size": 30,
      "lineHeight": 1.1,
      "weight": 650,
      "tracking": -0.02
    },
    "headline": {
      "size": 22,
      "lineHeight": 1.2,
      "weight": 650,
      "tracking": -0.015

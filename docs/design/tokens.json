      "tracking": 0
    },
    "label": {
      "size": 12.5,
      "lineHeight": 1.3,
      "weight": 600,
      "tracking": 0
    },
    "caption": {
      "size": 11,
      "lineHeight": 1.3,
      "weight": 500,
      "tracking": 0
    },
    "code": {
      "size": 13,
      "lineHeight": 1.3,
      "weight": 700,
      "tracking": 0.14,
      "font": "mono"
    }

<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleDevelopmentRegion</key>
    <string>en</string>
    <key>CFBundleExecutable</key>
    <string>nectarlink-desktop</string>
    <key>CFBundleIconFile</key>
    <string>NectarLink.icns</string>
    <key>CFBundleIdentifier</key>
    <string>app.nectarlink.desktop</string>
    <key>CFBundleInfoDictionaryVersion</key>
    <string>6.0</string>
    <key>CFBundleName</key>
    <string>NectarLink</string>
    <key>CFBundleDisplayName</key>
    <string>NectarLink</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleShortVersionString</key>
    <string>@VERSION@</string>
    <key>CFBundleVersion</key>
    <string>@BUNDLE_VERSION@</string>
    <key>LSMinimumSystemVersion</key>
    <string>14.0</string>
    <key>NSHighResolutionCapable</key>
    <true/>
    <key>NSLocalNetworkUsageDescription</key>
    <string>NectarLink discovers and connects to your paired phone over the local network.</string>
    <key>NSBluetoothAlwaysUsageDescription</key>
    <string>NectarLink uses Bluetooth to discover nearby paired devices.</string>
    <key>NSMicrophoneUsageDescription</key>
    <string>NectarLink records the Mac's microphone when you talk on a phone call through the Mac.</string>
</dict>
</plist>

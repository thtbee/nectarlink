<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleExecutable</key>
	<string>app.nectarlink.desktop.camera-extension</string>
	<key>CFBundleIdentifier</key>
	<string>app.nectarlink.desktop.camera-extension</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>NectarLink Webcam</string>
	<key>CFBundleDisplayName</key>
	<string>NectarLink Webcam</string>
	<key>CFBundlePackageType</key>
	<string>SYSX</string>
	<key>CFBundleShortVersionString</key>
	<string>@VERSION@</string>
	<key>CFBundleVersion</key>
	<string>@BUNDLE_VERSION@</string>
	<key>CMIOExtension</key>
	<dict>
		<key>CMIOExtensionMachServiceName</key>
		<string>@APP_GROUP_ID@.camera-extension</string>
	</dict>
	<key>LSMinimumSystemVersion</key>
	<string>12.3</string>
	<key>NLAppGroupID</key>
	<string>@APP_GROUP_ID@</string>
	<key>NSSystemExtensionUsageDescription</key>
	<string>NectarLink uses a Camera Extension to provide your phone's camera as a virtual webcam to apps like Zoom, Teams, and Meet.</string>
</dict>
</plist>
